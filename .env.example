# Copy this file to .env and fill in what you need. The core pipeline runs
# fully offline on local models; everything here is optional.

# --- Understanding layer (STRONGLY recommended) --------------------------------
# Without a key, the explanation/summary uses local BART/flan-t5, which produce
# choppy, hard-to-follow text on spoken transcripts. With a key, an LLM writes
# a proper teachable explanation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Or any OpenAI-compatible provider (free tiers, no card) -----------------
# These take precedence over GEMINI_API_KEY. Several providers have a usable
# free tier; the models are smaller than Gemini Flash and not multimodal, so
# keyframes are not sent — still a long way better than the offline fallback.
#
#   Groq        https://console.groq.com/keys
# VS_LLM_BASE_URL=https://api.groq.com/openai/v1
# VS_LLM_MODEL=llama-3.3-70b-versatile
# VS_LLM_API_KEY=gsk_...
#
#   OpenRouter  https://openrouter.ai/keys   (models ending :free)
# VS_LLM_BASE_URL=https://openrouter.ai/api/v1
# VS_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# VS_LLM_API_KEY=sk-or-...
#
#   Ollama, running locally — no key needed, any string works
# VS_LLM_BASE_URL=http://localhost:11434/v1
# VS_LLM_MODEL=llama3.1
# VS_LLM_API_KEY=ollama

# Optional overrides for the understanding layer
# VS_UNDERSTANDING_MODEL=gemini-2.0-flash
# VS_UNDERSTANDING_TEMPERATURE=0.35
# VS_UNDERSTANDING_MAX_TOKENS=16384

# --- Transcription language --------------------------------------------------
# Leave unset to auto-detect (recommended — handles non-English videos).
# VS_WHISPER_LANGUAGE=en

# --- Cache location ---------------------------------------------------------
# If this project lives in a OneDrive/Dropbox folder, point the cache at a
# non-synced path to avoid file-lock errors.
# VS_CACHE_DIR=C:/vs_cache

# --- Offline mode ---------------------------------------------------------
# After the first run downloads every model, set this to skip Hugging Face
# update checks — makes startup independent of the network.
# VS_OFFLINE=1

# --- YouTube auth (only if downloads hit bot-check) ------------------------
# VS_DLP_COOKIES_FROM_BROWSER=chrome

# Team / header info shown in the UI
# TEAM_NAMES=Jaivardhan Singh, Sujay Chand, Harshit Raj
# GUIDE_NAME=Dr. Deepa K
# PROJECT_TITLE=AI-Based Video Summarization System
