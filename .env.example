# Copy this file to .env and fill in values as needed. Nothing here is required
# for the core pipeline to run — it works fully offline with local models.

# Optional: override the cache directory (default: ./cache)
# If this project lives inside a OneDrive/Dropbox-synced folder, the sync
# client can briefly lock cache files right after they're written (frequent
# state.json rewrites are the most common trigger), which can raise
# WinError 5 on Windows. Pointing the cache at a non-synced local path
# avoids that class of error entirely, e.g.:
# VS_CACHE_DIR=C:/vs_cache

# Optional: enable Gemini-backed Q&A generation instead of the local
# flan-t5-base model. Leave unset to stay fully local/offline.
# GEMINI_API_KEY=

# Optional: if YouTube downloads fail with "Please sign in" / bot-check even
# after upgrading yt-dlp (age-restricted or region-locked videos), set this
# to a browser you're logged into YouTube with, e.g. "chrome" / "edge" /
# "firefox". yt-dlp will read that browser's cookies locally to authenticate.
# YT_DLP_COOKIES_FROM_BROWSER=

# Team / header info shown in the Streamlit UI (all optional, have defaults)
# TEAM_NAMES=Jaivardhan Singh, Sujay Chand, Harshit Raj
# GUIDE_NAME=Dr. Deepa K
# PROJECT_TITLE=AI-Based Video Summarization System
