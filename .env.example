# Copy this file to .env and fill in what you need. The core pipeline runs
# fully offline on local models; everything here is optional.

# --- Understanding layer (STRONGLY recommended) --------------------------------
# Without a key, the explanation/summary uses local BART/flan-t5, which produce
# choppy, hard-to-follow text on spoken transcripts. With a key, an LLM writes
# a proper teachable explanation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Or any OpenAI-compatible provider (free tiers, no card) -----------------
# These take precedence over GEMINI_API_KEY. Several providers have a usable
# free tier; the models are smaller than Gemini Flash and not multimodal, so
# keyframes are not sent — still a long way better than the offline fallback.
#
#   Groq        https://console.groq.com/keys
# VS_LLM_BASE_URL=https://api.groq.com/openai/v1
# VS_LLM_MODEL=llama-3.3-70b-versatile
# VS_LLM_API_KEY=gsk_...
#
#   OpenRouter  https://openrouter.ai/keys   (models ending :free)
# VS_LLM_BASE_URL=https://openrouter.ai/api/v1
# VS_LLM_MODEL=dots-studio/dots-3-note-preview:free, nvidia/nemotron-3-super-120b-a12b:free
#
#   A comma-separated list is a preference order, not a pool: the first
#   is used until it stops answering, then the next. Free endpoints go
#   down for stretches, and naming a spare turns a failed run into a
#   slower one. It does not buy more quota — the daily limit belongs to
#   the account, so when that is gone every model reports the same.
# VS_LLM_API_KEY=sk-or-...
#
#   Picked from https://openrouter.ai/api/v1/models (no key needed to read
#   it) for the three things this pipeline needs: a context large enough for
#   a window of transcript, response_format support so the JSON schema is
#   enforced, and image input so keyframes can go too. A text-only
#   alternative with more capacity:
#     VS_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   The Gemma free endpoints answered 429 "rate-limited upstream" on every
#   attempt here, so test a model before settling on it rather than trusting
#   that it is listed.
#
#   Ollama, running locally — no key needed, any string works
# VS_LLM_BASE_URL=http://localhost:11434/v1
# VS_LLM_MODEL=llama3.1
# VS_LLM_API_KEY=ollama
#
# Which free tier to pick depends on the shape of the request, not the model.
# A 25-minute window of a long transcript is 7k-10k tokens measured on real
# runs here (an 11-hour lecture is ~640k characters of speech), and free tiers
# meter tokens per minute as well as per day:
#
#   * Groq is the fastest, but its free tier allows a few thousand tokens per
#     minute, which a single window can exceed outright. Good for short
#     videos, awkward for long ones. Narrow the window if you use it:
#     VS_UNDERSTANDING_WINDOW_MIN=10
#   * OpenRouter meters requests per day (tens, without purchased credits)
#     rather than tokens per minute, which suits the few large calls this
#     pipeline makes. Fewer, bigger windows is the right trade there.
#
# Both rotate which models are free — check the provider's model list rather
# than trusting the IDs above. Free completion ceilings are also well below
# Gemini's, so what the client asks for is clamped:
# VS_LLM_MAX_OUTPUT_TOKENS=8192

#   More accounts, when one day's allowance is not enough. Each is its own
#   daily quota and they are used in order, each until it is spent. One
#   11-hour video fully explored is about 33 calls; a free allowance is
#   around 50, so one account is a video and a half a day and three is four
#   or five. All three settings are needed or the block is ignored.
# VS_LLM2_BASE_URL=https://openrouter.ai/api/v1
# VS_LLM2_MODEL=dots-studio/dots-3-note-preview:free
# VS_LLM2_API_KEY=sk-or-...
#
# VS_LLM3_BASE_URL=https://api.groq.com/openai/v1
# VS_LLM3_MODEL=llama-3.3-70b-versatile
# VS_LLM3_API_KEY=gsk_...
#   Groq meters tokens per minute as well as per day, and one window of a
#   long transcript can exceed its per-minute allowance on its own. Lower
#   VS_UNDERSTANDING_WINDOW_MIN if you put it in the chain.

# Optional overrides for the understanding layer
# VS_UNDERSTANDING_MODEL=gemini-2.0-flash
# VS_UNDERSTANDING_TEMPERATURE=0.35
# VS_UNDERSTANDING_MAX_TOKENS=16384

# --- Transcription language --------------------------------------------------
# Leave unset to auto-detect (recommended — handles non-English videos).
# VS_WHISPER_LANGUAGE=en

# --- Cache location ---------------------------------------------------------
# If this project lives in a OneDrive/Dropbox folder, point the cache at a
# non-synced path to avoid file-lock errors.
# VS_CACHE_DIR=C:/vs_cache

# --- Offline mode ---------------------------------------------------------
# After the first run downloads every model, set this to skip Hugging Face
# update checks — makes startup independent of the network.
# VS_OFFLINE=1

# --- YouTube auth (only if downloads hit bot-check) ------------------------
# VS_DLP_COOKIES_FROM_BROWSER=chrome

# Team / header info shown in the UI
# TEAM_NAMES=Jaivardhan Singh, Sujay Chand, Harshit Raj
# GUIDE_NAME=Dr. Deepa K
# PROJECT_TITLE=AI-Based Video Summarization System

# --- Browser accounts, limits, and optional payments -----------------------
# Leaving VS_JWT_SECRET empty keeps the API open for local development. Set a
# long random value to enable the web sign-in menu and bearer-token protection.
# VS_JWT_SECRET=
# VS_JWT_ALGORITHM=HS256
# VS_SESSION_TTL_DAYS=30
# VS_DEV_OTP_ECHO=0                  # required outside private local demos
# VS_SMTP_HOST=smtp.example.com
# VS_SMTP_PORT=587
# VS_SMTP_USER=
# VS_SMTP_PASSWORD=
# VS_SMTP_FROM=
# VS_GOOGLE_CLIENT_ID=
# VS_GOOGLE_CLIENT_SECRET=
# VS_GOOGLE_REDIRECT_URI=https://your-frontend.example/auth/google
# VS_FREE_MAX_VIDEO_HOURS=4
# VS_FREE_DAILY_CALLS=40
# VS_PREMIUM_MAX_VIDEO_HOURS=15
# VS_PREMIUM_DAILY_CALLS=400
# VS_RAZORPAY_KEY_ID=rzp_test_...
# VS_RAZORPAY_KEY_SECRET=
# VS_RAZORPAY_MODE=test
# VS_PREMIUM_PRICE_PAISE=19900

# --- Sharing the app -------------------------------------------------------
# scripts/serve.ps1 -Public opens a throwaway Cloudflare URL that needs no
# account and changes every run. -Ngrok uses the one static domain a free
# ngrok account includes, so the address keeps working between restarts --
# put it here after running: ngrok config add-authtoken <token>
# VS_NGROK_DOMAIN=your-name.ngrok-free.dev
